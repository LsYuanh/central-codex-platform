# Central Codex Platform development configuration
# Copy this file to .env before starting a formal service.
# The current local Spike has its own copy at spikes/local-dev/.env.example.

APP_ENV=development

# Local control-plane listener (the current Spike uses these values).
CENTRAL_HOST=127.0.0.1
CENTRAL_PORT=4310

# SQLite is the default for local PoC development.
# Keep the database outside source-controlled code and runtime artifacts.
DATABASE_URL=sqlite://./data/central.db

# SQLite connection tuning. WAL is enabled by the initializer.
DATABASE_BUSY_TIMEOUT_MS=5000

# Keep logs useful without leaking credentials or full environment variables.
RUST_LOG=info
