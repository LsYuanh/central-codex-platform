+// Included in the pinned dynamic handler by the reviewed version overlay.
+// The reserved transport tools are never registered in the model tool catalog.
+async fn request_reviewed_device_tool(
+    invocation: &ToolInvocation,
+    arguments: Value,
+) -> Option<DynamicToolResponse> {
+    use crate::guardian::{GuardianApprovalRequest, GuardianReviewContext, GuardianReviewOptions};
+    use codex_protocol::config_types::ApprovalsReviewer;
+    use codex_protocol::dynamic_tools::DynamicToolCallOutputContentItem;
+    use codex_protocol::protocol::{AskForApproval, ReviewDecision};
+    let transport = |name: &str| ToolName::new(Some("yuan_zhou_device_approval".into()), name);
+    let prepared = request_dynamic_tool(
+        &invocation.session,
+        &invocation.turn,
+        format!("{}:prepare", invocation.call_id),
+        transport("prepare"),
+        serde_json::json!({"tool":invocation.tool_name.name,"arguments":arguments}),
+    )
+    .await?;
+    if !prepared.success {
+        return Some(prepared);
+    }
+    let data: Value = match prepared.content_items.first() {
+        Some(DynamicToolCallOutputContentItem::InputText { text }) => {
+            serde_json::from_str(text).ok()?
+        }
+        _ => return None,
+    };
+    let token = data.get("token")?.as_str()?;
+    let live_config = invocation.session.get_config().await;
+    let requirements = live_config.config_layer_stack.requirements();
+    let mandatory = requirements
+        .auto_review_required_for_model(&invocation.step_context.settings.model_info.slug)
+        || requirements
+            .approvals_reviewer
+            .can_set(&ApprovalsReviewer::User)
+            .is_err();
+    let mode = if mandatory {
+        "auto"
+    } else {
+        data.get("mode")?.as_str()?
+    };
+    let (outcome, reason) = match mode {
+        "full" => ("approved", String::new()),
+        "ask" => ("manual", String::new()),
+        "auto" => {
+            let mut context = GuardianReviewContext::from(&invocation.step_context);
+            // Review a remote operation as an external tool, without granting central permissions.
+            context.approval_policy = AskForApproval::OnRequest;
+            context.approvals_reviewer = ApprovalsReviewer::AutoReview;
+            let request = GuardianApprovalRequest::McpToolCall {
+                id: invocation.call_id.clone(), server: "yuan_zhou_local_agent".into(),
+                tool_name: invocation.tool_name.name.clone(), arguments: Some(data["action"].clone()),
+                connector_id: None, connector_name: Some("远舟客户端 Local Agent".into()),
+                connector_description: None, connected_account_email: None, tool_title: None,
+                tool_description: Some("Execute the exact prepared operation on the connected client. Paths are client paths, never central paths. No implicit authorization follows from the default output directory.".into()),
+                annotations: None,
+            };
+            let review = crate::guardian::spawn_approval_decision(
+                invocation.session.clone(),
+                context,
+                crate::guardian::new_guardian_review_id(),
+                request,
+                crate::tools::sandboxing::ApprovalRequestReasons {
+                    approval: Some("Client device operation".into()),
+                    retry: None,
+                },
+                GuardianReviewOptions {
+                    require_guardian: true,
+                    require_synchronous_review: true,
+                    plugin_attribution_override: None,
+                    approval_request_source:
+                        codex_analytics::GuardianApprovalRequestSource::MainTurn,
+                    external_cancel: Some(invocation.cancellation_token.clone()),
+                },
+            );
+            match review.await.ok().flatten() {
+                Some(ReviewDecision::Approved | ReviewDecision::ApprovedForSession) => {
+                    ("approved", String::new())
+                }
+                Some(ReviewDecision::Denied { rejection }) => ("denied", rejection),
+                Some(ReviewDecision::Abort) => ("cancelled", "Native review cancelled".into()),
+                Some(ReviewDecision::TimedOut) => (
+                    "unavailable",
+                    "Native review timed out; manual approval required".into(),
+                ),
+                _ => (
+                    "unavailable",
+                    "Native reviewer unavailable; manual approval required".into(),
+                ),
+            }
+        }
+        _ => ("cancelled", "Invalid device permission mode".into()),
+    };
+    let outcome = if mandatory && outcome == "unavailable" {
+        "cancelled"
+    } else {
+        outcome
+    };
+    let outcome = if invocation.cancellation_token.is_cancelled() {
+        "cancelled"
+    } else {
+        outcome
+    };
+    request_dynamic_tool(
+        &invocation.session,
+        &invocation.turn,
+        invocation.call_id.clone(),
+        transport("complete"),
+        serde_json::json!({"token":token,"outcome":outcome,"reason":reason}),
+    )
+    .await
+}
