# Local-dev Spike configuration. Safe defaults; no secrets belong here.
APP_ENV=development
CENTRAL_HOST=127.0.0.1
CENTRAL_PORT=4310
DATABASE_URL=sqlite://./data/central.db
DATABASE_BUSY_TIMEOUT_MS=5000
RUST_LOG=info

# Optional browser/Tauri direct-connect mode for a local Codex App Server.
# Start Codex on 4500; npm run dev:browser starts the Origin-stripping proxy on 4501.
VITE_CODEX_APP_SERVER_URL=ws://127.0.0.1:4501
VITE_CODEX_APP_SERVER_CWD=

# B.6 Day 3 local central-gateway-v1 test path (App Server is spawned by the gateway via stdio).
VITE_CENTRAL_HOST=central.example
VITE_PLATFORM_GATEWAY_URL=ws://central.example:4510/ws?userId=desktop-user&deviceId=desktop-device
